rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- FUNCTIONS HỖ TRỢ ---
    function signedIn() { return request.auth != null; }
    function userDoc(uid) { return get(/databases/$(database)/documents/users/$(uid)); }
    
    function isAdmin(uid) { 
      let data = userDoc(uid).data;
      return signedIn() && (data.get('roleGlobal', '') == 'admin' || data.get('role', '') == 'admin');
    }
    
    function isMaster(uid) { 
      let data = userDoc(uid).data;
      return signedIn() && (
        data.get('roleGlobal', '') == 'master' || 
        data.get('role', '') == 'master' ||
        data.get('isMaster', false) == true
      );
    }

    function isManager(uid) { 
      let data = userDoc(uid).data;
      return signedIn() && (
        data.get('roleGlobal', '') == 'manager' || 
        data.get('role', '') == 'manager'
      );
    }

    function isStaff(uid) {
      let data = userDoc(uid).data;
      let role = data.get('roleGlobal', '');
      return signedIn() && (role == 'staff' || role == ''); 
    }
    
    function userChain(uid) { return userDoc(uid).data.get('chainId', ''); }
    function userStore(uid) { return userDoc(uid).data.get('storeId', ''); }

    // --- QUY TẮC CHO USERS ---
    match /users/{uid} {
      allow read: if signedIn() && (
        request.auth.uid == uid 
        || isAdmin(request.auth.uid) 
        || (isMaster(request.auth.uid) && (
             resource.data.get('chainId', '') == userChain(request.auth.uid) ||
             resource.data.get('chainId', '') == ''
           ))
        || (isManager(request.auth.uid) && (
             resource.data.get('storeId', '') == userStore(request.auth.uid) ||
             resource.data.get('chainId', '') == ''
           ))
      );
      allow create: if signedIn(); 
      allow update: if signedIn() && (
        request.auth.uid == uid 
        || isAdmin(request.auth.uid) 
        || (isMaster(request.auth.uid) && (
             resource.data.get('chainId', '') == userChain(request.auth.uid) ||
             resource.data.get('chainId', '') == ''
           ))
        || (isManager(request.auth.uid) && resource.data.get('storeId', '') == userStore(request.auth.uid))
      );
    }

    // --- QUY TẮC CHO INVITATIONS ---
    match /invitations/{inviteId} {
      allow read: if signedIn() && (
        request.auth.uid == resource.data.receiverUid 
        || request.auth.uid == resource.data.senderUid
        || isAdmin(request.auth.uid)
      );
      allow create: if isMaster(request.auth.uid) || isAdmin(request.auth.uid) || isManager(request.auth.uid);
      allow update: if signedIn() && (request.auth.uid == resource.data.receiverUid);
      allow delete: if signedIn() && (request.auth.uid == resource.data.senderUid || isAdmin(request.auth.uid));
    }

    // --- QUY TẮC CHO PRODUCTS ---
    match /products/{productId} {
      // Cho phép đọc nếu là Admin, hoặc thuộc cùng Chain, hoặc thuộc cùng Store
      allow read: if signedIn() && (
        isAdmin(request.auth.uid)
        || resource.data.get('chainId', '') == userChain(request.auth.uid)
        || resource.data.get('storeId', '') == userStore(request.auth.uid)
        || resource.data.get('chainId', '') == "" // Toàn hệ thống (nếu có)
      );
      
      allow write: if isAdmin(request.auth.uid) || (
        isMaster(request.auth.uid) && (
          (request.resource != null && request.resource.data.get('chainId', '') == userChain(request.auth.uid)) ||
          (resource != null && resource.data.get('chainId', '') == userChain(request.auth.uid))
        )
      ) || (
        isManager(request.auth.uid) && (
          (request.resource != null && request.resource.data.get('storeId', '') == userStore(request.auth.uid)) ||
          (resource != null && resource.data.get('storeId', '') == userStore(request.auth.uid))
        )
      ) || (
        isStaff(request.auth.uid) && (
          (request.resource != null && request.resource.data.get('storeId', '') == userStore(request.auth.uid)) ||
          (resource != null && resource.data.get('storeId', '') == userStore(request.auth.uid))
        )
      );
    }

    // --- QUY TẮC CHO ORDERS ---
    match /orders/{orderId} {
      allow read: if signedIn() && (
        isAdmin(request.auth.uid) 
        || resource.data.get('chainId', '') == userChain(request.auth.uid)
        || resource.data.get('storeId', '') == userStore(request.auth.uid)
      );
      allow write: if signedIn() && (
        isAdmin(request.auth.uid) || 
        request.resource.data.get('chainId', '') == userChain(request.auth.uid) ||
        resource.data.get('chainId', '') == userChain(request.auth.uid) ||
        request.resource.data.get('storeId', '') == userStore(request.auth.uid) ||
        resource.data.get('storeId', '') == userStore(request.auth.uid)
      );
    }

    // --- CÁC COLLECTION KHÁC ---
    match /chains/{chainId} {
      allow read: if signedIn();
      allow write: if isAdmin(request.auth.uid);
    }

    match /stores/{storeId} {
      allow read: if signedIn();
      allow write: if isAdmin(request.auth.uid) || (
        isMaster(request.auth.uid) && (
          // Create/Update: check new data chainId
          (request.resource != null && request.resource.data.get('chainId', '') == userChain(request.auth.uid)) ||
          // Delete/Update: check existing data chainId
          (resource != null && resource.data.get('chainId', '') == userChain(request.auth.uid))
        )
      );
    }

    match /{document=**} {
      allow read, write: if isAdmin(request.auth.uid);
    }
  }
}