<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_staff"
    app:startDestination="@id/staffHomeFragment">

    <fragment
        android:id="@+id/staffHomeFragment"
        android:name="com.invsmart.app.ui.view.StaffHomeFragment"
        android:label="fragment_staff_home"
        tools:layout="@layout/fragment_staff_home">
        <action
            android:id="@+id/action_staffHomeFragment_to_productListFragment"
            app:destination="@id/productListFragment" />
        <action
            android:id="@+id/action_staffHomeFragment_to_staffAccountFragment"
            app:destination="@id/staffAccountFragment" />
    </fragment>

    <fragment
        android:id="@+id/productListFragment"
        android:name="com.invsmart.app.ui.view.ProductListFragment"
        android:label="fragment_product_list"
        tools:layout="@layout/fragment_product_list">
        <action
            android:id="@+id/action_productListFragment_to_orderDetailFragment"
            app:destination="@id/orderDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/orderDetailFragment"
        android:name="com.invsmart.app.ui.view.OrderDetailFragment"
        android:label="fragment_order_detail"
        tools:layout="@layout/fragment_order_detail">
        <action
            android:id="@+id/action_orderDetailFragment_to_staffHomeFragment"
            app:destination="@id/staffHomeFragment"
            app:popUpTo="@id/staffHomeFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/paymentQrFragment"
        android:name="com.invsmart.app.ui.view.PaymentQrFragment"
        android:label="fragment_payment_qr"
        tools:layout="@layout/fragment_payment_qr">
        <action
            android:id="@+id/action_paymentQrFragment_to_staffHomeFragment"
            app:destination="@id/staffHomeFragment"
            app:popUpTo="@id/staffHomeFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/staffAccountFragment"
        android:name="com.invsmart.app.ui.view.StaffAccountFragment"
        android:label="fragment_staff_account"
        tools:layout="@layout/fragment_staff_account" />
</navigation>